{
  "name": "impulse-ts",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "TypeScript port of Impulse: pure engine wrapped by the digital-boardgame-framework (web + async multiplayer). Ported from the Impulse.Core C# engine.",
  "scripts": {
    "gen-cards": "node scripts/build-card-data.mjs",
    "build": "npm run gen-cards && vite build",
    "dev": "npm run gen-cards && vite",
    "typecheck": "npm run gen-cards && tsc --noEmit",
    "smoke": "npm run gen-cards && vite-node scripts/smoke-rollout.ts",
    "soak": "npm run gen-cards && vite-node scripts/soak.ts",
    "test": "npm run gen-cards && vitest run",
    "deploy": "npm run build && wrangler pages deploy --project-name=impulse-ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "digital-boardgame-framework": "^0.42.0",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.12",
    "vite-node": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.97.0"
  }
}
